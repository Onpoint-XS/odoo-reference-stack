# Copy to .env and fill in. .env is gitignored and must never be committed.

DB_USER=odoo
DB_PASSWORD=change_me
DB_NAME=odoo

# There is deliberately no ADMIN_PASSWD here.
#
# Odoo reads the master password from config/odoo.conf and never from the
# environment. A variable in this file looked configured, was never passed into the
# container, and left Odoo sitting on its built-in default. Set admin_passwd in
# config/odoo.conf instead.

# restic. The repository password is held by the customer, not by the contractor.
RESTIC_REPOSITORY=s3:https://s3.example.com/odoo-backups
RESTIC_PASSWORD_FILE=/run/secrets/restic_password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
