# Copy to .env and fill in. .env is gitignored and must never be committed.

DB_USER=odoo
DB_PASSWORD=change_me
DB_NAME=odoo

# Odoo master password. Controls the database manager.
# In production the database manager should be disabled entirely; see config/odoo.conf.
ADMIN_PASSWD=change_me_too

# restic. The repository password is held by the customer, not by the contractor.
RESTIC_REPOSITORY=s3:https://s3.example.com/odoo-backups
RESTIC_PASSWORD_FILE=/run/secrets/restic_password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
